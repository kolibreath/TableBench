    "http://dt.abc/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "workbench.html",
        "workhours.html",
        "estimation.html",
        "history.html",
        "vendor/icons.css",
        "vendor/fonts/element-icons.woff",
        "vendor/fonts/element-icons.ttf"
      ],
      "matches": ["http://ita.abc/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://ita.abc/*"],
      "js": ["content.js"],
      "css": ["vendor/icons.css", "content.css"],
      "run_at": "document_end"
